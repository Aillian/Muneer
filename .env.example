# Muneer's settings: the pipeline, the Gradio app, the mock model and the
# model download. Copy to .env (it is git-ignored) and fill in. JSON values
# stay on one line. deploy/README.md says which settings each way of running
# Muneer reads. The model server's own settings are in server/.env.example.
#
# The all-in-one image (model and app in one container) also uses this file
# as its defaults; a pod's environment variables override them.

# ---- The model's weights (read where the model runs) ----
# The private Hugging Face repo with the weights, e.g. your-hf-username/muneer-14b.
MUNEER_HF_REPO=
# A Hugging Face token that can read that repo (fine-grained, read-only is
# best). Put the real token in .env only, never in this file, which is public.
# On RunPod, keep it in a RunPod secret instead (deploy/README.md).
HF_TOKEN=
# What serves the model in the all-in-one image: vllm (the real model; needs a
# 48 GB GPU) or mock (scripted replies, no GPU; for trying the image).
MODEL_SERVER=vllm

# ---- Muneer: the model's OpenAI-compatible API ----
# Until the RunPod pod is running, point this at the mock:  python -m mock_muneer
# Once it runs:  https://<pod-id>-8000.proxy.runpod.net/v1
# (127.0.0.1 rather than localhost: on Windows, localhost adds a 2-second delay.)
MUNEER_BASE_URL=http://127.0.0.1:8000/v1
# The key the model server was started with. The mock checks the same key;
# left empty, the mock checks none. In the all-in-one image, setting it opens
# the model's API on port 8000, behind this key (at least 32 characters);
# left empty, the model stays inside the container (deploy/README.md).
MUNEER_API_KEY=
MUNEER_MODEL=muneer
# Seconds per attempt; after one retry the visitor is asked to send the message again.
MUNEER_TIMEOUT_SECONDS=60

# ---- OpenAI: the guardrail and the simulated da'i ----
# Your OpenAI API key. Put the real key in .env only; never in this file,
# which is public. Set a monthly spending limit on the key in the OpenAI dashboard.
OPENAI_API_KEY=
# Optional: another OpenAI-compatible provider or proxy.
# OPENAI_BASE_URL=
# The model that reviews each reply.
GUARDRAIL_MODEL=gpt-5.6-sol
# How much the wording varies, from 0 (steadiest) to 2. Empty: the model's own
# default. gpt-5.6-sol takes only its own, so leave it empty for that model.
GUARDRAIL_TEMPERATURE=
# How hard a reasoning model thinks before labelling: none, minimal, low, medium,
# high or xhigh (empty: send none).
# A model that doesn't take a setting (gpt-4.1 has no reasoning effort;
# gpt-5.6-sol takes no temperature) gets requests without it, and the log says
# so once.
GUARDRAIL_REASONING_EFFORT=low
# Seconds per attempt. After one retry, a reply the guardrail couldn't check is held back.
GUARDRAIL_TIMEOUT_SECONDS=20
# The simulated da'i that takes over after a handoff, for the demo: it sends
# one message, giving the visitor what Muneer couldn't, and the conversation
# then closes. Its model settings work like the guardrail's.
SIMULATED_DAI_NAME=Mohammad
SIMULATED_DAI_MODEL=gpt-5.6-sol
SIMULATED_DAI_TEMPERATURE=
SIMULATED_DAI_REASONING_EFFORT=low
SIMULATED_DAI_TIMEOUT_SECONDS=30

# ---- Conversation limits and the database ----
MAX_MESSAGE_CHARS=2000
MAX_VISITOR_MESSAGES=40
# Shown after any message that asks for the visitor's contact details.
CONSENT_NOTICE=Sharing your contact details is optional. We use them only to send you learning material about Islam, and you can ask us to stop at any time.
# The database (SQLite): every conversation and message, exactly as typed, every
# guardrail verdict and simulated da'i reply, and the review queue of flagged
# replies for da'is (masked there). Deleting the file starts an empty one.
DATABASE_PATH=data/muneer.sqlite3

# ---- Placeholder filling ----
# Markers around placeholder names in Muneer's replies, as the model writes
# them: [org_name]. Names are lower_snake_case with at least one underscore.
PLACEHOLDER_OPEN=[
PLACEHOLDER_CLOSE=]

# The organisation profile: placeholder name -> value. The model writes these
# three: the assistant's name, and the organisation's name and email.
PLACEHOLDERS={"ai_name": "Muneer", "org_name": "Bathel", "org_email": "info@bathel.sa"}

# Replacement rules. The text is read left to right; where two rules match at
# the same place, the one listed first wins. Optional per rule:
# "ignore_case" (default false) and "whole_word" (default true).
# These rules give the current model Muneer's name instead of its old persona
# name, Daee. Add rules for any other text the model learned in your own .env.
REPLACEMENT_RULES=[{"find": "Daee, an AI Islamic Advisor", "replace": "Muneer, an AI Islamic Advisor"}, {"find": "Daee, I'm an AI Islamic Advisor", "replace": "Muneer, I'm an AI Islamic Advisor"}, {"find": "Daee, I’m an AI Islamic Advisor", "replace": "Muneer, I’m an AI Islamic Advisor"}, {"find": "an AI Islamic Advisor", "replace": "Muneer, an AI Islamic Advisor"}, {"find": "Daee", "replace": "Muneer"}]

# ---- The Gradio app ----
# 0.0.0.0 inside Docker, so the app is reachable from outside the container.
APP_HOST=127.0.0.1
APP_PORT=7860
# Visitor messages processed at once.
APP_CONCURRENCY=8
# The admin passcode opens the Conversations tab (every stored conversation)
# and unlocks every conversation's flagged replies in the review queue tab.
# Without it, the Conversations tab stays locked, and each visitor sees only
# their own flagged replies. Nothing limits guesses, so the app refuses one
# shorter than 16 characters. Make a long random one with:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_PASSCODE=

# ---- Mock Muneer (development only) ----
# Pause before each mock reply, to feel like real generation (milliseconds).
MOCK_DELAY_MS=600
