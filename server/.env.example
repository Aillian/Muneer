# Copy to server/.env (it is git-ignored) or set these in the RunPod pod
# template. Variables already in the environment win over this file.

# ---- Model source: set MUNEER_HF_REPO, or MUNEER_MODEL_PATH ----
# The private Hugging Face repo with the weights, and a read token for it.
MUNEER_HF_REPO=your-hf-username/muneer-14b
HF_TOKEN=
# Optional: pin a branch, tag or commit so restarts serve the same weights.
# MUNEER_HF_REVISION=main
# Download folder. Default: /workspace/models/muneer on RunPod,
# ~/.cache/muneer/models/muneer elsewhere.
# MUNEER_DOWNLOAD_DIR=
# Or serve weights already on disk (skips the download):
# MUNEER_MODEL_PATH=/workspace/models/muneer

# ---- API access ----
# Clients send it as "Authorization: Bearer <key>". Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MUNEER_API_KEY=
# MUNEER_SERVED_MODEL_NAME=muneer
# MUNEER_HOST=0.0.0.0
# MUNEER_PORT=8000

# ---- GPU and capacity ----
# Context window per conversation, in tokens (Muneer trained on 4,096).
# MUNEER_MAX_MODEL_LEN=8192
# Share of the GPU's memory vLLM may use (0.92 is vLLM's own default).
# MUNEER_GPU_MEMORY_UTILIZATION=0.92
# MUNEER_TENSOR_PARALLEL_SIZE=1
# Maximum conversations processed at once (vLLM picks a default).
# MUNEER_MAX_NUM_SEQS=
# fp8 roughly halves weight memory so the model fits a 24 GB GPU.
# MUNEER_QUANTIZATION=fp8

# ---- Default sampling (requests may override all but the output cap) ----
# MUNEER_TEMPERATURE=0.3
# MUNEER_TOP_P=0.95
# MUNEER_TOP_K=20
# MUNEER_REPETITION_PENALTY=1.1
# Added to each request that leaves them out (vLLM has no server-wide setting for these two).
# MUNEER_FREQUENCY_PENALTY=0.2
# MUNEER_PRESENCE_PENALTY=0
# Hard cap on tokens per reply.
# MUNEER_MAX_OUTPUT_TOKENS=1500

# ---- System prompt ----
# Added by the chat template to every conversation without a system message of
# its own, so the app and callers of the API get it alike. Default:
# system_prompt.md next to launch.py. An empty file adds none.
# MUNEER_SYSTEM_PROMPT_FILE=/absolute/path/to/prompt.md

# ---- Any other `vllm serve` flags ----
# MUNEER_VLLM_EXTRA_ARGS=--max-num-batched-tokens 8192
